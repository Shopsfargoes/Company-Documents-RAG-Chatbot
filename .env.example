# Copy to .env.local (never commit .env.local). Values are filled in per milestone.

# --- Supabase (Milestone 1) ---------------------------------------------------
# Dashboard > Project Settings > API Keys  (use the NEW keys, not anon/service_role)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# BACKEND ONLY. Bypasses RLS. Never expose in browser code or logs.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Gemini (Milestones 4-5) --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- OpenRouter (Milestone 5) -------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Provider selection (Milestone 5) -----------------------------------------
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# --- Google Drive OAuth (Milestone 3) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# --- Application --------------------------------------------------------------
APP_URL=http://localhost:3000
